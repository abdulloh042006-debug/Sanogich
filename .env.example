# Copy this file to .env and adjust values for your environment.

# Flask environment: development | production | testing
FLASK_ENV=development

# REQUIRED in production. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production

# Database connection string.
# Default (empty) uses a local SQLite file at instance/sanogich.db
# For PostgreSQL: postgresql+psycopg://user:password@localhost:5432/sanogich
DATABASE_URL=

# Where application logs are written in production (directory is created if missing).
LOG_DIR=logs

# Bind address for local runs (gunicorn uses gunicorn.conf.py instead).
HOST=127.0.0.1
PORT=5000
